# Local Docker Compose Postgres (used for `bun run dev` against docker-compose.yml)
DATABASE_URL="postgresql://typing_game:typing_game@localhost:5432/typing_game?schema=public"

# Separate database for the automated integration test suite
TEST_DATABASE_URL="postgresql://typing_game_test:typing_game_test@localhost:5433/typing_game_test?schema=public"

# For production, point this at your Supabase Postgres connection string instead, e.g:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public&pgbouncer=true"

JWT_SECRET="replace-with-a-long-random-string"
CORS_ORIGIN="http://localhost:3000"
NODE_ENV="development"
PORT=4000
